{
    auto_https off
    # ponytail: h3 advertised on 8443-8446 but docker only publishes TCP -> browsers stall on QUIC. Publish those ports /udp if h3 is ever wanted.
    servers {
        protocols h1 h2
    }
}

# Tailnet cert from `tailscale cert`, mounted from /etc/caddy/certs. TS_HOST lives in .env.
(ts) {
	tls /etc/caddy/certs/{$TS_HOST}.crt /etc/caddy/certs/{$TS_HOST}.key
}

netdata.homelab:80 {
    reverse_proxy netdata:19999
}

adguard.homelab:80 {
    reverse_proxy adguard:80
}

sparky.homelab:80 {
    reverse_proxy sparkyfitness-frontend:80
}

{$TS_HOST}:8443 {
    import ts
    reverse_proxy sparkyfitness-frontend:80
}

{$TS_HOST}:8444 {
    import ts
    reverse_proxy vaultwarden:80
}

